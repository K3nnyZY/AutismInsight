# Copy to .env at the repository root. Never put secrets in VITE_* variables.
OPENAI_API_KEY=
CHAT_MODEL=gpt-5.4-mini
PLANNER_MODEL=gpt-5.4-mini
EMBEDDING_MODEL=text-embedding-3-large
# This schema uses 1536 dimensions, including when using the large model.
DATABASE_URL=postgresql+psycopg://autism:local-dev-only@localhost:5432/autism_insight
POSTGRES_PASSWORD=local-dev-only
ENVIRONMENT=development
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
ALLOW_DEMO_SOURCES=true
CHAT_TIMEOUT_SECONDS=90
SESSION_TTL_DAYS=30
RATE_LIMIT_PER_MINUTE=12
# Logs omit prompts, answers and retrieved text. Tracing stays disabled by default.
LANGSMITH_TRACING=false
